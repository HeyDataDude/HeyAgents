# ──────────────────────────────────────────────────────────────────────────────
# Council environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Provider mode: "mock" (fully offline, deterministic, no keys) or "live".
COUNCIL_PROVIDER_MODE=mock

# ── Core API ──────────────────────────────────────────────────────────────────
COUNCIL_ENV=development
COUNCIL_API_HOST=0.0.0.0
COUNCIL_API_PORT=8000
COUNCIL_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
COUNCIL_CORS_ORIGINS=http://localhost:3000

# A single demo user is created on seed; real auth is pluggable (see docs).
COUNCIL_DEMO_USER_EMAIL=you@example.com

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────────
POSTGRES_USER=council
POSTGRES_PASSWORD=council
POSTGRES_DB=council
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Async URL used by the app; sync URL used by Alembic migrations.
COUNCIL_DATABASE_URL=postgresql+asyncpg://council:council@db:5432/council
COUNCIL_DATABASE_URL_SYNC=postgresql+psycopg://council:council@db:5432/council

# ── Redis (durable job queue + pub/sub) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (raw audio, artifacts, exports, reports) ─────────────────────
# backend: "local" | "s3"
COUNCIL_STORAGE_BACKEND=local
COUNCIL_STORAGE_LOCAL_DIR=/data/storage
# S3 (used when backend=s3; works with MinIO too)
COUNCIL_S3_ENDPOINT_URL=
COUNCIL_S3_BUCKET=council
COUNCIL_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── LLM provider ────────────────────────────────────────────────────────────────
# provider: "mock" | "openai" | "anthropic" | "ollama"
COUNCIL_LLM_PROVIDER=mock
COUNCIL_LLM_DEFAULT_MODEL=gpt-4o-mini
COUNCIL_LLM_FAST_MODEL=gpt-4o-mini
COUNCIL_LLM_DEEP_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (pgvector semantic search) ───────────────────────────────────────
# provider: "mock" | "openai" | "ollama"
COUNCIL_EMBEDDING_PROVIDER=mock
COUNCIL_EMBEDDING_MODEL=text-embedding-3-small
COUNCIL_EMBEDDING_DIM=1536

# ── Speech-to-text (recorded thoughts) ──────────────────────────────────────────
# provider: "mock" | "faster_whisper" | "whisperx" | "openai"
COUNCIL_STT_PROVIDER=mock
COUNCIL_STT_MODEL=base
COUNCIL_STT_DEVICE=cpu

# ── Text-to-speech ──────────────────────────────────────────────────────────────
# provider: "mock" | "openai" | "elevenlabs"
COUNCIL_TTS_PROVIDER=mock
COUNCIL_TTS_VOICE=calm

# ── Web / research provider ─────────────────────────────────────────────────────
# provider: "mock" | "tavily" | "serper"
COUNCIL_RESEARCH_PROVIDER=mock
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Persistent agent memory (Letta) ─────────────────────────────────────────────
# provider: "mock" | "letta"
COUNCIL_AGENT_MEMORY_PROVIDER=mock
LETTA_BASE_URL=http://localhost:8283
LETTA_API_KEY=

# ── Realtime voice (LiveKit) ────────────────────────────────────────────────────
# provider: "mock" | "livekit"
COUNCIL_REALTIME_PROVIDER=mock
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Reports scheduling ──────────────────────────────────────────────────────────
COUNCIL_ENABLE_MORNING_BRIEF=true
COUNCIL_ENABLE_DAILY_BRIEF=true
COUNCIL_ENABLE_WEEKLY_SYNTHESIS=true

# ── Frontend ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
